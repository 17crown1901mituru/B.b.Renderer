name: Build APK

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 20

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Verify no NDK/C++ files (project policy)
        run: |
          if find . -name "CMakeLists.txt" -o -name "*.cpp" -o -name "*.cc" | grep -q .; then
            echo "::error::CMakeLists.txt or C++ sources found. This project is Java/Kotlin-only."
            exit 1
          fi

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.7

      - name: Cache Gradle packages
        uses: actions/cache@v4
        with:
          path: |
            ~/.gradle/caches
            ~/.gradle/wrapper
          key: ${{ runner.os }}-gradle-${{ hashFiles('**/*.gradle*', '**/gradle-wrapper.properties') }}
          restore-keys: |
            ${{ runner.os }}-gradle-

      - name: Decode Keystore
        run: |
          echo "${{ secrets.KEYSTORE_BASE64 }}" | base64 --decode > app/B.b-key.jks

      - name: Set current date
        run: |
          echo "BUILD_DATE=$(TZ='Asia/Tokyo' date +'%Y%m%d-%H%M')" >> $GITHUB_ENV
          # versionCode用。Intに収める必要があるためUnixエポック秒を使う
          # (BUILD_DATEのYYYYMMDDHHmm形式は12桁でInt上限[約21億]を超えるため使えない)。
          # 2026-08対応: versionCodeが常に固定の1のままだったため、MT Managerの
          # 「インストール前にversionCodeを検証する」設定に引っかかり、APKの中身が
          # 変わっていても実質再インストールされない事故が起きていた。
          echo "BUILD_VERSION_CODE=$(date +'%s')" >> $GITHUB_ENV

      - name: Build debug APK
        run: gradle assembleDebug --no-daemon
        env:
          KEYSTORE_FILE: B.b-key.jks
          KEYSTORE_PASSWORD: ${{ secrets.KEY_STORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
          BUILD_VERSION_CODE: ${{ env.BUILD_VERSION_CODE }}
          BUILD_DATE_LABEL: ${{ env.BUILD_DATE }}

      - name: Rename APK file
        run: |
          cd app/build/outputs/apk/debug/
          mv app-debug.apk "app-debug-${{ env.BUILD_DATE }}.apk"

      # -----------------------------------------------------------------
      # 1. ソースコードの Zip アーカイブを作成
      # -----------------------------------------------------------------
      - name: Create Source Zip Archive
        run: |
          zip -r "app-source-${{ env.BUILD_DATE }}.zip" . \
            -x "*.git*" \
            -x "*/build/*" \
            -x "*/.gradle/*" \
            -x "*.jks" \
            -x "*.keystore"

      # -----------------------------------------------------------------
      # 2. Pandoc と WeasyPrint を使用して PDF ガイドを生成
      # -----------------------------------------------------------------
      - name: Install PDF conversion tools
        run: |
          sudo apt-get update
          sudo apt-get install -y pandoc python3-pip fonts-noto-cjk
          pip install weasyprint --break-system-packages

      - name: Generate PDF Documentation
        run: |
          # README.md から PDF を生成（日本語フォント適用）
          if [ -f "README.md" ]; then
            pandoc README.md -o "guide-${{ env.BUILD_DATE }}.pdf" \
              --pdf-engine=weasyprint \
              -V mainfont="Noto Sans CJK JP"
          else
            echo "README.md not found. Creating minimal notice PDF."
            echo "# Build Documentation\n\nGenerated on ${{ env.BUILD_DATE }}" > temp.md
            pandoc temp.md -o "guide-${{ env.BUILD_DATE }}.pdf" --pdf-engine=weasyprint
          fi

      # -----------------------------------------------------------------
      # 3. APK、Zip、PDF をまとめて1つのアーティファクトとしてアップロード
      # -----------------------------------------------------------------
      - name: Upload Build Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: "bb-renderer-debug-${{ env.BUILD_DATE }}"
          path: |
            app/build/outputs/apk/debug/app-debug-${{ env.BUILD_DATE }}.apk
            app-source-${{ env.BUILD_DATE }}.zip
            guide-${{ env.BUILD_DATE }}.pdf
          retention-days: 1
          if-no-files-found: error
