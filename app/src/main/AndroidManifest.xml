<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- サイト単位/グローバル設定の「画面を常時オンにする(WAKE_LOCK)」機能に必要。
         BrowserCapabilityBridge.requestWakeLock()がPowerManager.WakeLockを取得する際、
         この権限が無いとSecurityExceptionでクラッシュする(2026-07、マニフェスト確認時に
         宣言漏れを発見)。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 2026-08、file://によるローカルHTML/画像読み込み対応で追加。API 33以降は
         スコープドストレージ+細分化されたメディア権限に置き換わっており、この権限は
         意味を持たなくなる(アプリ専用ディレクトリ配下は元々権限不要でアクセス可)ため
         maxSdkVersionで上限を切ってある。API 26〜32の端末で公開ストレージ
         (/storage/emulated/0/Download等)のファイルをfile://で直接開きたい場合のみ、
         この権限のランタイム許可(設定アプリからの手動許可でも可)が必要になる。
         詳細はEngineActivity.readLocalFile()・README.md参照。 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- network_security_config.xmlはbase-config cleartextTrafficPermitted="true"に
         している(2026-08、https→httpへのリダイレクト先で「CLEARTEXT communication
         ... not permitted by network security policy」となり、外部サイトへの
         遷移が失敗する不具合を修正した際の変更)。汎用ブラウザとしての意図的な設定で、
         Chrome/Firefox等の一般ブラウザアプリも同様に平文通信をアプリ側で許可しており、
         危険性の警告はブラウザのUI側の役割としている。localhost/127.0.0.1向けの
         domain-configは元々開発用ローカルサーバー向けに個別許可していたものだが、
         base-config側で全ドメイン許可済みのため現在は実質冗長(記録として残置)。
         詳細はREADME.md「既知の要修正ポイント」参照。 -->
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mwv"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name="com.B.b.Renderer.EngineActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 外部からhttp(s)リンクを開いた場合の受け口。EngineActivity#resolveInitialUrlが処理する -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <service
            android:name="com.B.b.Renderer.media.MediaPlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <!--
            ピン留めタブ(pinned)をActivity破棄後もプロセスごと生かし続けるための
            Foreground Service。標準カテゴリに当てはまらないためspecialUseを使用し、
            Play Storeポリシー上必須のPROPERTY_SPECIAL_USE_FGS_SUBTYPEで用途を明記する。
        -->
        <service
            android:name="com.B.b.Renderer.tabs.TabKeepAliveService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="pinned_browser_tabs_background_execution" />
        </service>

    </application>
</manifest>
