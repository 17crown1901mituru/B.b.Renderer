# If statement

if 2 + 2 != 4
  func()

# If else statement

if 2 + 2 == 4
    then 10
    else 0
   
# While loop
 
i = 0
list = [1 to 10]
while n < 9
  n = list[++i]
  
# Do while loop
 
j = 0
list = [1 to 10]
do
  j++
while list[j] < 9

# Switch statement, breaks added automatically, and multiple conditions are allowed
 
switch 6
case 1    then \hello
case 2, 4 then \boom
case 6
  'here it is'
default \something



