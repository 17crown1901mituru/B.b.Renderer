   import java.lang.String;
   import android.widget.Toast;
   import android.os.Bundle;
   import android.view.MenuItem;
   import android.view.Menu;
   ctx.setTheme(android.R.style.Theme_DeviceDefault_Light);
   protected void onCreate(Bundle savedinstance)
   {
      ctx.setTitle("Options Menu");
   }
   public boolean onPrepareOptionsMenu(Menu menu)
   {
      menu.clear();
      menu.add(Menu.NONE,1,Menu.NONE,"Option 1");
      menu.add(Menu.NONE,2,Menu.NONE,"Option 2");
      menu.add(Menu.NONE,3,Menu.NONE,"Exit");
      return true;
   }
   public boolean onOptionsItemSelected(MenuItem item)
   {
      switch (item.getItemId())
      {
         case 1:popup("Clicked Option 1");
         break ;
         case 2:popup("Clicked Option 2");
         break ;
         case 3:ctx.finish();
         break ;
         default :
      }
      return true;
   }
   
   private void popup(String txt)
   {
      Toast.makeText(ctx,txt,Toast.LENGTH_LONG).show();
   }
