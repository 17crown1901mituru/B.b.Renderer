    function setInterval(func,time,back)
   {
      var inte =  new pkg.utils.Interval(time,time);
      inte.setIntervalListener( function ()
      {
        if(!back){
         ctx.runOnUiThread( function ()
         {
            (func)();
         }
         );
         }else{
          (func)();
         }
      }
      );
       return inte;
   }
    function setTimeout(func,time,back)
   {
      var inte =  new pkg.utils.Interval(time,time);
      inte.setIntervalListener( function ()
      {
        if(!back){
         ctx.runOnUiThread( function ()
         {
            (func)();
         }
         );
         }else{
         (func)();
         }
         inte.stop();
      }
      );
       return inte;
   }
    function saveText(tag,value,name)
   {
      var nme;
      nme = name||"main";
      var sp = ctx.getSharedPreferences(nme,0);
      switch ( typeof (value))
      {
         case "number":sp.edit().putInt(tag,value).commit();
          break ;
         case "boolean":sp.edit().putBoolean(tag,value).commit();
          break ;
         case "string":sp.edit().putString(tag,value).commit();
          break ;
          default :
      }
      
   }
    function loadText(tag,name)
   {
      var chk;
      var nme;
      nme = name||"main";
      var sp = ctx.getSharedPreferences(nme,0);
      try 
      {
         chk = sp.getInt(tag,0);
      }
       catch (e)
      {
         try 
         {
            chk = sp.getBoolean(tag, false );
         }
          catch (e)
         {
            chk = sp.getString(tag,"");
         }
         
      }
       return chk;
   }
