    function props(obj)
   {
      var str = "";
      var arr = [];
      for (var x in obj)
      {
         arr.push(x);
      }
      arr = arr.sort();
      for (var i = 0;i<arr.length;i++)
      {
         try 
         {
            str += arr[i]+"\n\n" + obj[arr[i]]+"\n\n\n";
         }
          catch (e){}
      }
       return str;
   }
   
    function bTask(func,func2)
   {
      var as =  new pkg.utils.JASAsyncTask();
      as.doInBackground( function (v)
      {
         (func)(v);
      }
      );
      as.onPostExecute( function (v)
      {
          if (func2)(func2)(v);
      }
      );
       as.execute();
       return as;
   }
    function runOnUIThread(func)
   {
      ctx.runOnUiThread( new java.lang.Runnable(func));
   }
    function bThread(func)
   {
      var t =  new java.lang.Thread( new java.lang.Runnable(func));
      t.start();
       return t;
   }
    function bUIThread(func)
   {
       return bThread( function ()
      {
         runOnUIThread(func);
      }
      );
   }
    function setStatusBarBackgroundColor(color)
   {
       if (android.os.Build.VERSION.SDK_INT>=21)
      {
         ctx.getWindow().clearFlags(android.view.WindowManager.LayoutParams.FLAG_TRANSLUCENT_STATUS);
         ctx.getWindow().addFlags(android.view.WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS);
         ctx.getWindow().setStatusBarColor(color);
      }
      
   }
