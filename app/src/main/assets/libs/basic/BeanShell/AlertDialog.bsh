   import android.os.Bundle;
   import java.lang.String;
   import android.widget.Toast;
   import android.content.DialogInterface;
   import android.app.AlertDialog;
   protected void onCreate(Bundle savedInstanceState)
   {
      showDialog("Alert dialog message","Alert");
   }
   void showDialog(String message,String title)
   {
      AlertDialog.Builder builder =  new AlertDialog.Builder(ctx);
      builder.setMessage(message).setTitle(title).setPositiveButton("Ok", new DialogInterface.OnClickListener()
      {
         public void onClick(DialogInterface di,int p)
         {
            popup("Ok clicked");
            //di.dismiss();
            
         }
         
      }).setNegativeButton("Cancel", new DialogInterface.OnClickListener()
      {
         public void onClick(DialogInterface di,int p)
         {
            popup("Cancel clicked");
            //di.dismiss();
            
         }
         
      }).show();
   }
   void popup(String txt)
   {
      Toast.makeText(ctx,txt,Toast.LENGTH_LONG).show();
   }
   