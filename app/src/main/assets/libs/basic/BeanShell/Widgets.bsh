   import android.widget.*;
   import com.completeapps.jascriptapp.*;
   import android.graphics.Color;
   import android.view.Gravity;
   import android.os.Bundle;
   import android.widget.LinearLayout.LayoutParams;
   import android.view.KeyEvent;
   import android.view.View;
   
   int color = Color.parseColor("#236896");
   ctx.setTheme(android.R.style.Theme_DeviceDefault_Light_DarkActionBar);
   public void onCreate(Bundle b)
   {
      setActionBarBackgroundColor(color);
      setStatusBarBackgroundColor(color);
      Utils.setNavigationBarBackgroundColor(ctx,color);
      ctx.setTitle("Widgets");
      ScrollView sc = new ScrollView(ctx);
      sc.setFillViewport(true);
      LinearLayout lay =  new LinearLayout(ctx);
      lay.setPadding(30,30,30,30);
      lay.setLayoutParams( new LayoutParams(LayoutParams.MATCH_PARENT,LayoutParams.MATCH_PARENT,0));
      lay.setOrientation(LinearLayout.VERTICAL);
      Button btn =  new Button(ctx);
      btn.setLayoutParams( new LayoutParams(LayoutParams.WRAP_CONTENT,LayoutParams.WRAP_CONTENT,0));
     // int i = 0;
      btn.setOnClickListener( new View.OnClickListener()
      {
         public void onClick(View v)
         {
            popup("Click");
         //   i++;
         }
         
      });
      btn.setText("Button");
      lay.addView(btn);
      TextView tv =  new TextView(ctx);
      tv.setLayoutParams( new LayoutParams(LayoutParams.WRAP_CONTENT,LayoutParams.WRAP_CONTENT,0));
      tv.setText("TextView");
      lay.addView(tv);
      Switch sw = new Switch(ctx);
      sw.setChecked(true);
      lay.addView(sw);
      CheckBox chk =  new CheckBox(ctx);
      chk.setLayoutParams( new LayoutParams(LayoutParams.WRAP_CONTENT,LayoutParams.WRAP_CONTENT,0));
      chk.setText("CheckBox");
      chk.setChecked( true );
      lay.addView(chk);
      ToggleButton tgl =  new ToggleButton(ctx);
      tgl.setLayoutParams( new LayoutParams(LayoutParams.WRAP_CONTENT,LayoutParams.WRAP_CONTENT,0));
      tgl.setText("Toggle Button");
      lay.addView(tgl);
      SeekBar skb =  new SeekBar(ctx);
      skb.setLayoutParams( new LayoutParams(LayoutParams.MATCH_PARENT,LayoutParams.WRAP_CONTENT,0));
      skb.setMax(100);
      skb.setProgress(50);
      lay.addView(skb);
      EditText edt =  new EditText(ctx);
      edt.setLayoutParams( new LayoutParams(LayoutParams.MATCH_PARENT,LayoutParams.WRAP_CONTENT,0));
      edt.setText("Edit Text");
      lay.addView(edt);
      RadioButton rd = new RadioButton(ctx);
      rd.setChecked(false);
      RadioGroup rgg = new RadioGroup(ctx);
      rgg.addView(rd);
      lay.addView(rgg);
      RatingBar rt = new RatingBar(ctx);
      rt.setNumStars(8);
      rt.setRating(5);
      lay.addView(rt);
      CalendarView cl =  new CalendarView(ctx);
      lay.addView(cl);
      sc.addView(lay);
      ctx.setContentView(sc);
   }
   private void setStatusBarBackgroundColor(int color)
   {
      if (android.os.Build.VERSION.SDK_INT>=21)
      {
         ctx.getWindow().clearFlags(android.view.WindowManager.LayoutParams.FLAG_TRANSLUCENT_STATUS);
         ctx.getWindow().addFlags(android.view.WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS);
         ctx.getWindow().setStatusBarColor(color);
      }
      
   }
   private void setActionBarBackgroundColor(int color)
   {
      if (ctx.getActionBar()!= null )
      {
         ctx.getActionBar().setBackgroundDrawable( new android.graphics.drawable.ColorDrawable(color));
      }
      
   }
   private void popup(String s)
   {
      Toast.makeText(ctx,s,Toast.LENGTH_LONG).show();
   }
   public boolean onKeyUp(int keyCode, KeyEvent event)
   {
      return false;
   }
   
